# These args will run the tests defined in the example module
--module-path out:lib/bin
--add-modules "com.example.foo.test"

# Better enable assertions
-ea

# Use the logging properties
-Djava.util.logging.config.file=logging.properties

# This has to be the last line
-m work.archaic.minau/work.archaic.minau.Main com.example.foo.test
